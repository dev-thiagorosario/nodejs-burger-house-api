{
  "type": "module",
  "name": "nodejs-burger-house-api",
  "version": "1.0.0",
  "description": "Burger House HTTP API",
  "main": "dist/core/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/core/index.ts",
    "dev:docker": "npm run db:migrate && npm run db:seed && npm run dev",
    "start": "node dist/core/index.js",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed.ts",
    "db:seed:users": "tsx src/database/seeders/001-user-seeder.ts",
    "db:seed:product-categories": "tsx src/database/seeders/002-product-category-seeder.ts",
    "db:seed:burguer-products": "tsx src/database/seeders/004-burguer-product-seeder.ts",
    "db:seed:order-statuses": "tsx src/database/seeders/003-order-statuses-seeder.ts",
    "db:seed:orders": "npm run db:seed:users && npm run db:seed:order-statuses && npm run db:seed:burguer-products && tsx src/database/seeders/007-orders-seeder.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:seed:product-images": "tsx src/database/seeders/008-product-images-seeder.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  }
}
